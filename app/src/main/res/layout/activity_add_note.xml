<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddNoteActivity">

    <!-- Campo para ingresar el ID -->
    <EditText
        android:id="@+id/txtId"
        android:layout_width="282dp"
        android:layout_height="49dp"
        android:ems="10"
        android:inputType="text"
        android:hint="@string/id"
        android:textAlignment="center"
        android:background="@drawable/edittext_background"
        app:layout_constraintBottom_toTopOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.096" />

    <!-- Campo para ingresar el título (nombre de la nota) -->
    <EditText
        android:id="@+id/txtTitle"
        android:layout_width="282dp"
        android:layout_height="49dp"
        android:ems="10"
        android:inputType="text"
        android:hint="@string/title"
        android:textAlignment="center"
        android:background="@drawable/edittext_background"
        app:layout_constraintBottom_toTopOf="@id/multTxtDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtId"
        app:layout_constraintVertical_bias="0.096" />


    <!-- Botón para agregar una foto -->
    <Button
        android:id="@+id/btnAddPhoto"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:text="@string/addPhoto"
        android:textSize="12sp"
        app:cornerRadius="40dp"
        app:layout_constraintBottom_toTopOf="@id/multTxtDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintVertical_bias="0.244" />

    <!-- Campo de descripción de la nota -->
    <EditText
        android:id="@+id/multTxtDescription"
        android:layout_width="281dp"
        android:layout_height="416dp"
        android:ems="10"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:hint="@string/descNote"
        android:textSize="22sp"
        android:background="@drawable/edittext_background"
        app:layout_constraintBottom_toTopOf="@id/btnSaveAddNote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAddPhoto"
        app:layout_constraintVertical_bias="0.721" />

    <!-- Botón de cancelar -->
    <Button
        android:id="@+id/btnCancelAddNote"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:text="@string/btnCancel"
        android:textSize="18sp"
        app:cornerRadius="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.226"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.95" />

    <!-- Botón de guardar -->
    <Button
        android:id="@+id/btnSaveAddNote"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:text="@string/btnSave"
        android:textSize="18sp"
        app:cornerRadius="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.776"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.95" />

</androidx.constraintlayout.widget.ConstraintLayout>
